# Destinie AI Twin Studio — optional provider keys (server-side only)
#
# Phase 1 (identity foundation, uploads, analysis, versioning, comparison,
# exports) works with NO keys and NO costs. Image generation, 3D reconstruction
# and lip-sync require one of the providers below. Nothing is charged until you
# add a key and press "Generate".
#
# Copy to .env and fill in only what you choose to use.

# --- fal.ai (recommended for identity-preserving images + 3D + lip sync) ---
# https://fal.ai/dashboard/keys
# Billed per image/model by fal. PuLID portrait ≈ $0.03/megapixel.
FAL_KEY=

# --- OpenAI-compatible image API (alternative image provider) ---
# Works with OpenAI's own /v1 and with any OpenAI-compatible gateway.
# gpt-image-1 image edits are billed per image by your provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Studio options ---
# Where private uploads, SQLite and exports are stored (never served as static files).
# DESTINIE_DATA_DIR=./data
# API port used by `bun run start` and by the dev proxy.
# PORT=8787
