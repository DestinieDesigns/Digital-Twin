{
  "name": "destinie-ai-twin-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Destinie AI Twin Studio — identity-preserving digital human creation studio (Phase 1 foundation)",
  "scripts": {
    "setup": "bun run scripts/setup-assets.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "bun run setup && vite build",
    "start": "bun run server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "bun-types": "latest",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
